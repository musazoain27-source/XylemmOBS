# =====================================================================
# XylemmOBS Support — Environment Variables
# Copy this file to .env.local for local development.
# In Vercel, add these under Project Settings > Environment Variables.
# =====================================================================

# --- PUBLIC (safe to expose in the browser bundle) --------------------
# Found in Supabase: Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Found in Supabase: Project Settings > API > Project API keys > anon public
# This key is safe client-side ONLY because every table is protected by
# Row Level Security (see supabase/schema.sql). Never grant it more than
# RLS allows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- SERVER-ONLY (never prefix with NEXT_PUBLIC_, never ship to client) -
# Found in Supabase: Project Settings > API > Project API keys > service_role
# This key bypasses Row Level Security entirely. It is used ONLY inside
# server-side API routes (app/api/**) for a small number of trusted
# operations (generating sequential public IDs, writing activity logs,
# reading admin notes). It must never be imported into any file that
# also ships client-side code, and must never be logged.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# A random, private string used to sign the short-lived admin login
# rate-limit cookie. Generate one with: openssl rand -base64 32
ADMIN_RATE_LIMIT_SECRET=replace-with-a-long-random-string
